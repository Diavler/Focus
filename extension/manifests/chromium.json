{
  "manifest_version": 3,
  "name": "Focus",
  "version": "0.1.0",
  "description": "Blocks distractions during Focus sessions. Needs the Focus app running.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "spanning",
  "background": { "service_worker": "background.js" },
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*", "*://*.youtube.com/*"],
      "js": ["feeds.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["interstitial.html", "interstitial.js"], "matches": ["<all_urls>"] }
  ]
}
